# Asset filenames are content-hashed, so correctness never depends on a long
# max-age here - only edge/browser hit-rate does.
#
# The max-age is deliberately SHORT, and deliberately not "immutable".
# This host answers a request for a MISSING /assets/* file with the SPA
# fallback page (HTTP 200 + text/html), and that response inherits this rule.
# A browser can therefore cache the fallback HTML *as* the JS/CSS file and
# white-screen with "Failed to load module script: ... MIME type of text/html".
# We cannot vary this rule by response content-type, so the window in which a
# poisoned entry can survive is capped instead: one hour, not one year.
#
# Do not raise this back to 31536000 (and do not add "immutable") unless
# missing /assets/* requests are returning a real 404 first - verify with
# `npm run check:deploy`.
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
