NODE_ENV=development

# Encrypts the readable copy of each shop-portal password, so the office can read
# one back to a shopkeeper who has lost theirs (Shops -> Share -> Show password).
# Any long random string; keep it out of the database and out of git.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave it unset and nothing breaks - passwords are still hashed and still work,
# they simply cannot be read back. Changing it makes copies stored under the old
# value unreadable; logins are unaffected.
CREDENTIAL_SECRET=

# Twilio WhatsApp (deprecated - now using email)
# TWILIO_ACCOUNT_SID= Your Twilio Account SID
# TWILIO_AUTH_TOKEN = Your Twilio Auth Token
# TWILIO_WHATSAPP_FROM = Your Twilio WhatsApp number (format: +1234567890)

# Email Configuration (Resend) - used for admin login codes, verification and invoices
# Get a key at https://resend.com (free tier: 100 emails/day)
# EMAIL_FROM must use a domain verified in Resend, or the shared test sender below.
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=I Mobile Service Center <onboarding@resend.dev>

# Email Configuration (SMTP) - legacy fallback, not used by the Resend sender
# For Gmail: Use smtp.gmail.com, port 587, and app-specific password
# For Outlook: Use smtp-mail.outlook.com, port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=dexlanka@gmail.com
SMTP_PASS=egny tnsm wwdr zeek
SMTP_FROM=noreply@imobile.com
